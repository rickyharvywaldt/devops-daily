        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in ANGLE. A type confusion vulnerability in ANGLE, a graphics abstraction layer used in Google Chrome, allows a remote attacker to exploit the flaw. By crafting a malicious HTML page, the attacker can trigger this vulnerability. This could potentially lead to the execution of arbitrary code outside of the browser's security sandbox, compromising the affected system.",
            "title": "Vulnerability description"
          },
