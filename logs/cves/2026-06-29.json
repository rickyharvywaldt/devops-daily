        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2466684"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in fast-uri. A remote attacker could exploit this vulnerability by crafting a malicious Uniform Resource Identifier (URI) that contains percent-encoded authority delimiters. The fast-uri library incorrectly decodes these delimiters during normalization and then re-emits them as raw separators, which can change the URI's intended authority. This issue allows applications that perform host allowlist checks, redirect validation, or outbound request routing to be steered to a different authority than specified, potentially bypassing security controls.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "fast-uri: fast-uri: URI authority bypass due to improper delimiter handling",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
