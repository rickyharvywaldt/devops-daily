        "problemTypes": [
          {
            "descriptions": [
              {
                "description": "CWE-79 Cross-Site Scripting (XSS)",
                "lang": "en",
                "type": "CWE"
              }
            ]
          }
        ],
        "affected": [
          {
            "vendor": "Unknown",
            "product": "Admin Columns for ACF Fields",
            "versions": [
              {
                "status": "affected",
