              }
            ],
            "defaultStatus": "unaffected"
          }
        ],
        "descriptions": [
          {
            "lang": "en",
            "value": "The User Profile Builder  WordPress plugin before 3.16.4 does not correctly bind the automatic login performed after user registration to the newly created account, allowing unauthenticated attackers to obtain an authenticated session for an arbitrary existing user, including administrators, on sites using a supported but non-default configuration."
          }
        ],
