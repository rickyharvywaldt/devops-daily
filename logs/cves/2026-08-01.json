    "vulnerabilities": [
      {
        "cve": "CVE-2025-68211",
        "cwe": {
          "id": "CWE-606",
          "name": "Unchecked Input for Loop Condition"
        },
        "discovery_date": "2025-12-16T00:00:00+00:00",
        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2422696"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A resource exhaustion vulnerability was found in the Kernel Same-page Merging (KSM) subsystem of the Linux kernel. When scanning processes with large sparse virtual memory mappings (e.g., 32 TiB with one mapped page), ksmd inefficiently walks every address rather than skipping unmapped holes. This causes ksmd to consume 100% CPU for extended periods.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "kernel: ksm: use range-walk function to jump over holes in scan_get_next_rmap_item",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "Any process can create large sparse mappings with MADV_MERGEABLE, causing ksmd to waste CPU cycles. This is a denial of service against the KSM deduplication daemon rather than a memory corruption issue.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
