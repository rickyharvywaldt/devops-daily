        "title": "Support Genix Lite < 1.4.48 - Unauthenticated Arbitrary File Read via Path Traversal",
        "problemTypes": [
          {
            "descriptions": [
              {
                "description": "CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')",
                "lang": "en",
                "type": "CWE"
