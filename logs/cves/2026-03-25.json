        "notes": [
          {
            "category": "description",
            "text": "A denial of service flaw has been discovered in the python Authlib package. Authlib’s JOSE implementation accepts unbounded JWS/JWT header and signature segments. A remote attacker can craft a token whose base64url‑encoded header or signature spans hundreds of megabytes. During verification, Authlib decodes and parses the full input before it is rejected, driving CPU and memory consumption to hostile levels and enabling denial of service.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "authlib: Authlib Denial of Service",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
