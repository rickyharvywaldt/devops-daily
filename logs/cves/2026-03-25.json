        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2417711"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A path traversal flaw has been discovered in Keras. The vulnerability arises because the function uses Python's tarfile.extractall() method without the security-critical filter='data' parameter. Although Keras attempts to filter unsafe paths using filter_safe_paths(), this filtering occurs before extraction, and a PATH_MAX symlink resolution bug triggers during extraction. This bug causes symlink resolution to fail due to path length limits, resulting in a security bypass that allows files to be written outside the intended extraction directory.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "keras: Path Traversal Vulnerability in keras",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
