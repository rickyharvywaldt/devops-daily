    "containers": {
      "cna": {
        "affected": [
          {
            "defaultStatus": "unaffected",
            "platforms": [
              "MacOS"
            ],
            "product": "Phoenix Code",
            "vendor": "Core.ai",
            "versions": [
              {
                "lessThanOrEqual": "4.0.3",
                "status": "affected",
                "version": "0",
