        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in the Hashicorp vault. Vault’s PKI mount issuer endpoints did not correctly authorize access to remove an issuer or modify issuer metadata, potentially resulting in a denial of service of the PKI mount. This bug did not affect public or private key material, trust chains, or certificate issuance.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "hashicorp/vault: Vault’s PKI Issuer Endpoint Did Not Correctly Authorize Access to Issuer Metadata",
            "title": "Vulnerability summary"
          },
          {
