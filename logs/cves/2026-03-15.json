        "notes": [
          {
            "category": "description",
            "text": "A vulnerability was found in the WebOb package. WebOb normalizes the HTTP Location header using urlparse and urljoin. If the URL starts with //, urlparse treats the following part as the hostname, and replaces the original request's hostname. This issue, combined with user interaction, may become a vulnerability.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "webob: WebOb's location header normalization during redirect leads to open redirect",
            "title": "Vulnerability summary"
