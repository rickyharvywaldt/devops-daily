            "url": "https://plugins.trac.wordpress.org/changeset/3374769/usc-e-shop"
          },
          {
            "url": "https://www.welcart.com/archives/26052.html"
          }
        ],
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "description": "CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')",
