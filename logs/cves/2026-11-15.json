        "title": "GeoPulse 1.5.0 through 2.3.0 IDOR via Geocoding Place-Details Endpoint",
        "descriptions": [
          {
            "lang": "en",
            "value": "GeoPulse 1.5.0 through 2.3.0 contains an insecure direct object reference vulnerability in GET /api/v1/places/geocoding/{id} that allows authenticated users to read other users' private locations. Attackers can enumerate sequential reverse_geocoding_location ids to retrieve other users' custom place names, city, country, coordinates and bounding boxes from their history."
          }
        ],
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "description": "Authorization Bypass Through User-Controlled Key",
                "cweId": "CWE-639",
                "type": "CWE"
              }
            ]
          }
        ],
        "affected": [
          {
            "vendor": "tess1o",
            "product": "GeoPulse",
            "defaultStatus": "unaffected",
            "versions": [
              {
                "version": "1.5.0",
