        "title": "Netcccyun dnsmgr 2.18 before 2.22 Missing Authorization via get_domain_default_line",
        "descriptions": [
          {
            "lang": "en",
            "value": "Netcccyun dnsmgr 2.18 before 2.22 contains a missing authorization vulnerability in POST /cloudflare/get_domain_default_line that allows restricted users to access domains outside their permissions. Restricted sub-users or single-domain logins can iterate the domain_id parameter to enumerate panel domain ids and read each domain's DNS line list and default line."
          }
        ],
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "description": "Missing Authorization",
                "cweId": "CWE-862",
                "type": "CWE"
              }
            ]
          }
        ],
