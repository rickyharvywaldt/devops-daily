              "Red Hat Advanced Cluster Management for Kubernetes 2.15:registry.redhat.io/rhacm2/volsync-operator-bundle@sha256:dada417982350c8f5b0ea5285d5568ac2ca23cba871de64fa80c9d2af43de48c_amd64"
