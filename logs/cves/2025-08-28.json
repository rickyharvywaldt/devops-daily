          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "1034490"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "An integer overflow flaw was found in the way the Linux kernel's Frame Buffer device implementation mapped kernel memory to user space via the mmap syscall. A local user able to access a frame buffer device file (/dev/fb*) could possibly use this flaw to escalate their privileges on the system.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "kernel: integer overflow in fb_mmap",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "This issue does not affect the version of the kernel package as shipped with Red Hat Enterprise MRG 2.\n\nThis issue affects the versions of Linux kernel as shipped with Red Hat Enterprise Linux 5. Future kernel updates for Red Hat Enterprise Linux 5 may address this issue.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
