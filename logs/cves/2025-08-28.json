    "vulnerabilities": [
      {
        "cve": "CVE-2012-6689",
        "discovery_date": "2012-08-14T00:00:00+00:00",
        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "848949"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "The netlink_sendmsg function in net/netlink/af_netlink.c in the Linux kernel before 3.5.5 does not validate the dst_pid field, which allows local users to have an unspecified impact by spoofing Netlink messages.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "libmnl: incorrect validation of netlink message origin allows attackers to spoof netlink messages",
            "title": "Vulnerability summary"
          },
