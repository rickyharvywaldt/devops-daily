      "cveId": "CVE-2026-2652",
      "assignerOrgId": "c09c270a-b464-47c1-9133-acb35b22c19a",
      "state": "PUBLISHED",
      "assignerShortName": "@huntr_ai",
      "dateReserved": "2026-02-18T02:53:33.607Z",
