        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in the HashiCorp Vault. The Vault and Vault Enterprise (“Vault”) LDAP auth method allows unauthenticated users to potentially enumerate valid accounts in the configured LDAP system by observing the response error when querying usernames.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "Hashicorp/vault: Vault’s LDAP Auth Method Allows for User Enumeration",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
