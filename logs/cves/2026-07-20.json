        "cve": "CVE-2025-30204",
        "cwe": {
          "id": "CWE-405",
          "name": "Asymmetric Resource Consumption (Amplification)"
        },
        "discovery_date": "2025-03-21T22:00:43.818367+00:00",
        "ids": [
