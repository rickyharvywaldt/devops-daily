            "product_ids": [
              "Red Hat Web Terminal 1.14:registry.redhat.io/web-terminal/web-terminal-operator-bundle@sha256:f729c368c8c4024a93c6cb8e46a45d1e2d6e99df5cedbc1e613a4798f5cbbfb2_amd64",
