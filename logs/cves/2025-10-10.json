        "discovery_date": "2025-06-11T12:45:38.797000+00:00",
        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2372281"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in Thunderbird. The Mozilla Foundation's Security Advisory describes the following issue: A crafted HTML email using mailbox:/// links can trigger automatic, unsolicited downloads of .pdf files to the user's desktop or home directory without prompting, even if auto-saving is disabled. This behavior can be abused to fill the disk with garbage data (e.g. using /dev/urandom on Linux) or to leak Windows credentials via SMB links when the email is viewed in HTML mode. While user interaction is required to download the .pdf file, visual obfuscation can conceal the download trigger. Viewing the email in HTML mode is enough to load external content.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "thunderbird: Unsolicited File Download, Disk Space Exhaustion, and Credential Leakage via mailbox:/// Links",
            "title": "Vulnerability summary"
          },
