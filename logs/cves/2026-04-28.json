      "cveId": "CVE-2026-31622",
      "assignerOrgId": "416baaa9-dc9f-4396-8d5f-8c081fb06d67",
      "state": "PUBLISHED",
      "assignerShortName": "Linux",
      "dateReserved": "2026-03-09T15:48:24.124Z",
      "datePublished": "2026-04-24T14:42:39.916Z",
