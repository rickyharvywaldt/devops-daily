        "datePublic": "2019-01-07T00:00:00.000Z",
        "title": "BlueAuditor 1.7.2.0 Buffer Overflow Denial of Service via Registration Key",
        "descriptions": [
          {
            "lang": "en",
            "value": "BlueAuditor 1.7.2.0 contains a buffer overflow vulnerability in the registration key field that allows local attackers to crash the application by submitting an oversized key value. Attackers can trigger a denial of service by entering a 256-byte buffer of repeated characters in the Key registration field, causing the application to crash during registration processing."
          }
        ],
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "description": "Out-of-bounds Write",
                "cweId": "CWE-787",
                "type": "CWE"
              }
            ]
          }
        ],
