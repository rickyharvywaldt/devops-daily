        "title": "VM lowlevel restriction bypass via raw.apparmor and raw.qemu.conf",
        "affected": [
          {
            "vendor": "Canonical",
            "product": "lxd",
            "platforms": [
              "Linux"
            ],
            "collectionURL": "https://github.com/canonical",
