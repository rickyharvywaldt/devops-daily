[
  {
    "dataType": "CVE_RECORD",
    "dataVersion": "5.2",
    "cveMetadata": {
      "cveId": "CVE-2025-7195",
      "assignerOrgId": "53f830b8-0a3f-465b-8143-3b8a9948e749",
