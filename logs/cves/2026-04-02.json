        "title": "Insecure Direct Object Reference (IDOR) Leading to Signature Forgery in Foxit eSign",
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "cweId": "CWE-284",
                "description": "CWE-284: Improper Access Control",
