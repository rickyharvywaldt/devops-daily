        "title": "Use after free of view cache in Foxit PDF Editor/Reader",
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "cweId": "CWE-416",
                "description": "CWE-416 Use after free",
                "type": "CWE"
              }
            ]
          }
        ],
