        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2447194"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A missing verification step has been discovered in PyJWT. PyJWT does not validate the crit (Critical) Header Parameter defined in RFC 7515 §4.1.11. When a JWS token contains a crit array listing extensions that PyJWT does not understand, the library accepts the token instead of rejecting it. This violates the MUST requirement in the RFC.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "pyjwt: PyJWT accepts unknown `crit` header extensions (RFC 7515 §4.1.11 MUST violation)",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
