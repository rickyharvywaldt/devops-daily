        "title": "WPvivid Backup & Migration < 0.9.131 - Unauthenticated Path Traversal via send_to_site_connect",
        "problemTypes": [
          {
            "descriptions": [
              {
                "description": "CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')",
                "lang": "en",
                "type": "CWE"
              }
            ]
          }
        ],
        "affected": [
          {
            "vendor": "Unknown",
            "product": "WPvivid — Backup, Migration & Staging",
            "versions": [
              {
                "status": "affected",
                "versionType": "semver",
                "version": "0",
                "lessThan": "0.9.131"
              }
            ],
            "defaultStatus": "unaffected"
          }
        ],
        "descriptions": [
          {
            "lang": "en",
            "value": "The WPvivid — Backup, Migration & Staging WordPress plugin before 0.9.131 does not sanitise a value taken from an unauthenticated request before using it to build a log file path, allowing an attacker holding a site to site transfer key to create a log file in any existing writable directory of the site, including the web root.\n\nThe file name always carries a fixed suffix and the contents are always the WPvivid — Backup, Migration & Staging WordPress plugin before 0.9.131's own log header, so only the location of the file is attacker controlled."
          }
        ],
        "references": [
