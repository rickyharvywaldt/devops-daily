        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2533175"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in gRPC-Go. Servers created with xds.NewGRPCServer() can be exploited by a remote client sending a malformed RPC request that lacks the required :authority or Host headers. This can trigger an index-out-of-bounds panic, leading to the termination of the entire server process and a Denial of Service (DoS). In some deployments, this attack can be unauthenticated.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "google.golang.org/grpc: gRPC-Go: Denial of Service via malformed RPC requests",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
