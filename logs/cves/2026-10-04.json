        },
        "discovery_date": "2026-08-13T22:13:18.319384+00:00",
        "flags": [
          {
            "label": "vulnerable_code_not_present",
            "product_ids": [
              "Red Hat Lightspeed (formerly Insights) for Runtimes 1.0:registry.redhat.io/rh-lightspeed-runtimes/runtimes-inventory-operator-bundle@sha256:aae0571689746a48abf3b5160d471f9c22487191602776ba48ae1650a7acfe9f_amd64"
