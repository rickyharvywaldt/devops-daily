              "AppStream-8.10.0.Z.MAIN.EUS:webkit2gtk3-0:2.54.0-1.el8_10.aarch64",
              "AppStream-8.10.0.Z.MAIN.EUS:webkit2gtk3-0:2.54.0-1.el8_10.i686",
