        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2541815"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in Hugo. This vulnerability allows information disclosure when Hugo executes build tools under the Node.js permission model, which validates only lexical file paths and fails to restrict symbolic links pointing outside the sandbox. An attacker capable of contributing content to a repository can exploit this by committing a symbolic link targeting sensitive host files alongside a build tool that reads it. Consequently, files readable by the build process can be exposed and embedded into the published site.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "github.com/gohugoio/hugo: Hugo: Arbitrary file read via symbolic link sandbox escape",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "This vulnerability is rated as Moderate impact because successful exploitation requires processing an untrusted project or pull request that specifically utilizes Node.js asset pipelines. Although an attacker could expose sensitive local files accessible to the builder by introducing malicious symlinks into the source tree, this flaw cannot be exploited remotely without direct user interaction or automated build triggers. Build systems and projects that only process trusted content or do not invoke Node.js asset transformations are not at risk.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
