        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2515836"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in golang.org/x/mod/sumdb. A malicious Go checksum database (GOSUMDB) can serve arbitrary module content that is not recorded in the transparency log. This allows a coordinated Go proxy (GOPROXY) and GOSUMDB to deliver malicious module content to a client, which cannot be detected by examining the transparency log. This vulnerability could lead to a supply chain compromise, allowing attackers to distribute malicious code.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "golang.org/x/mod/sumdb: golang.org/x/mod/sumdb: Integrity bypass via malicious GOSUMDB",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "This Important vulnerability in `golang.org/x/mod/sumdb` allows for a supply chain compromise where a malicious GOSUMDB can serve arbitrary module content, bypassing transparency log verification. This impacts the integrity of Go module dependencies in Red Hat products that utilize the Go toolchain and interact with GOSUMDB, posing a significant risk to development and deployment environments.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
