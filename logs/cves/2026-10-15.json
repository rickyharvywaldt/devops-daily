    "containers": {
      "cna": {
        "affected": [
          {
            "defaultStatus": "unaffected",
            "modules": [
              "IPv4 ARP (sys/netinet)"
            ],
            "product": "DragonFlyBSD",
            "programFiles": [
              "sys/netinet/if_ether.c"
            ],
            "programRoutines": [
              {
                "name": "arpintr()"
              },
              {
                "name": "in_arpinput()"
              },
              {
                "name": "in_arpreply()"
              }
            ],
            "repo": "https://github.com/DragonFlyBSD/DragonFlyBSD",
            "vendor": "DragonFlyBSD",
            "versions": [
              {
                "lessThan": "4bb22ffcf2e9fb44995fbfd9945194afc87fb182",
                "status": "affected",
                "version": "984263bcb83ad82313113c6ac840d99124d8f90c",
                "versionType": "git"
              }
            ]
          }
        ],
        "descriptions": [
          {
            "lang": "en",
            "value": "In DragonFly BSD through 6.4.2 before 4bb22ff, the ARP input handlers arpintr() and in_arpinput() (sys/netinet/if_ether.c) do not validate the hardware address length (ar_hln) and protocol address length (ar_pln) fields of incoming ARP packets. in_arpreply() then uses these attacker-controlled values as memcpy lengths when copying from kernel buffers that are only 6 and 4 bytes long, resulting in an out-of-bounds read of kernel heap and stack memory that is copied into the ARP reply sent back to the requester. An unauthenticated attacker on the adjacent network can use a single crafted ARP request to disclose up to roughly 250 bytes of each type of kernel memory, including kernel pointers. This is expected to be fixed in the 6.6 stable release when that is available."
          }
        ],
        "metrics": [
          {
            "cvssV4_0": {
              "Automatable": "NOT_DEFINED",
              "Recovery": "NOT_DEFINED",
              "Safety": "NOT_DEFINED",
              "attackComplexity": "LOW",
