            "descriptions": [
              {
                "cweId": "CWE-130",
                "description": "CWE-130 Improper Handling of Length Parameter Inconsistency",
                "lang": "en",
                "type": "CWE"
              }
            ]
          }
        ],
        "providerMetadata": {
          "orgId": "8254265b-2729-46b6-b9e3-3dfca2d5bfca",
          "shortName": "mitre",
          "dateUpdated": "2026-10-15T03:23:47.830Z"
        },
        "references": [
          {
            "url": "https://github.com/DragonFlyBSD/DragonFlyBSD/commit/4bb22ffcf2e9fb44995fbfd9945194afc87fb182"
          }
        ],
        "solutions": [
          {
            "lang": "en",
            "supportingMedia": [
              {
                "base64": false,
                "type": "text/html",
                "value": "Update to DragonFly BSD 6.6 once released (the maintainers have confirmed the fix will be included), or apply commit 4bb22ffcf2e9fb44995fbfd9945194afc87fb182 from master, which rejects ARP packets whose <code>ar_hln</code> is not <code>ETHER_ADDR_LEN</code> in <code>arpintr()</code> and whose <code>ar_pln</code> is not <code>sizeof(struct in_addr)</code> in <code>in_arpinput()</code>."
              }
            ],
            "value": "Update to DragonFly BSD 6.6 once released (the maintainers have confirmed the fix will be included), or apply commit 4bb22ffcf2e9fb44995fbfd9945194afc87fb182 from master, which rejects ARP packets whose ar_hln is not ETHER_ADDR_LEN in arpintr() and whose ar_pln is not sizeof(struct in_addr) in in_arpinput()."
          }
        ],
