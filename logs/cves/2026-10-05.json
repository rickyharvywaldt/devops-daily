        "title": "Apache HTTP Server: mod_dav_fs property database read access",
        "problemTypes": [
          {
            "descriptions": [
              {
                "description": "CWE-552 Files or directories accessible to external parties",
                "lang": "en",
                "cweId": "CWE-552",
