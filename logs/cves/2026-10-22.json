        "discovery_date": "2026-09-03T00:00:00+00:00",
        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2543296"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in libsoup. When the permessage-deflate WebSocket extension compresses a very large outgoing message, truncated size calculations used for GByteArray growth could wrap, causing zlib to write past the allocated buffer and resulting in a heap buffer overflow.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "libsoup: libsoup: Heap buffer overflow during outgoing permessage-deflate buffer growth",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "This issue is rated Important. Exploitation requires the permessage-deflate extension to be negotiated and a very large outgoing message to be compressed. Applications that enable WebSocket deflate with untrusted or unbounded message sizes are affected. Impact is heap corruption or denial of service.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
