              "Red Hat Web Terminal 1.16:registry.redhat.io/web-terminal/web-terminal-rhel9-operator@sha256:0880560f5d2aa6a707d55d3b2c27f0eaee1dcf985e9fda7fc51be92ed79364ef_amd64",
              "Red Hat Web Terminal 1.16:registry.redhat.io/web-terminal/web-terminal-tooling-rhel9@sha256:3332a2966bcdda130d6938366e51b685294604842bcd973cf46e8e7770509124_amd64"
            ]
