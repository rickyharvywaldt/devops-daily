    "cveMetadata": {
      "cveId": "CVE-2026-113681",
      "assignerOrgId": "83251b91-4cc7-4094-a5c7-464a1b83ea10",
      "state": "PUBLISHED",
      "assignerShortName": "VulnCheck",
      "dateReserved": "2026-10-20T14:51:02.489Z",
      "datePublished": "2026-10-20T15:40:41.797Z",
      "dateUpdated": "2026-10-22T09:49:36.614Z"
    },
    "containers": {
      "cna": {
        "providerMetadata": {
          "orgId": "83251b91-4cc7-4094-a5c7-464a1b83ea10",
          "shortName": "VulnCheck",
          "dateUpdated": "2026-10-22T09:49:36.614Z"
        },
        "datePublic": "2026-10-13T13:19:03.000Z",
        "title": "OpenImageIO before 3.0.20.0, 3.1.x before 3.1.15.0, and 3.2.x before 3.2.0.3-beta1 Cineon Reader Heap Out-of-Bounds Read",
        "descriptions": [
          {
            "lang": "en",
            "value": "OpenImageIO before 3.0.20.0, 3.1.x before 3.1.15.0, and 3.2.x before 3.2.0.3-beta1 contains an integer overflow in cineon::Codec::Read that undersizes the scanline buffer, causing a heap out-of-bounds read. Attackers can supply a crafted Cineon file with a huge declared width that wraps the size calculation to zero, so UnPackPacked reads past a 4-byte buffer and crashes the application."
          }
        ],
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "description": "Integer Overflow or Wraparound",
                "cweId": "CWE-190",
                "type": "CWE"
              }
            ]
          }
        ],
        "affected": [
          {
            "vendor": "AcademySoftwareFoundation",
            "product": "OpenImageIO",
            "defaultStatus": "unaffected",
            "versions": [
              {
                "version": "0",
                "lessThan": "3.0.20.0",
                "versionType": "custom",
                "status": "affected"
              },
              {
                "version": "3.1.0.0",
