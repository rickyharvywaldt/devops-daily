        "flags": [
          {
            "label": "vulnerable_code_not_present",
            "product_ids": [
              "Red Hat Update Infrastructure 5:registry.redhat.io/rhui5/installer-rhel9@sha256:2c50c87906a1abebf427a70f401c409f1258cb55d2096f517db870ec991cfd7f_amd64"
