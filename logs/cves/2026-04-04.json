      "cna": {
        "title": "Electron: Context Isolation bypass via contextBridge VideoFrame transfer",
        "problemTypes": [
          {
            "descriptions": [
              {
                "cweId": "CWE-668",
                "lang": "en",
                "description": "CWE-668: Exposure of Resource to Wrong Sphere",
