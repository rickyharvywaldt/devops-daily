        "title": "Operator-sdk: privilege escalation due to incorrect permissions of /etc/passwd",
        "metrics": [
          {
            "other": {
              "content": {
                "value": "Moderate",
                "namespace": "https://access.redhat.com/security/updates/classification/"
              },
              "type": "Red Hat severity rating"
