    "containers": {
      "cna": {
        "title": "Cloudreve is vulnerable to Account Takeover via Weak Cryptographic Token Generation (Insecure PRNG Seeding)",
        "problemTypes": [
          {
            "descriptions": [
              {
                "cweId": "CWE-338",
                "lang": "en",
                "description": "CWE-338: Use of Cryptographically Weak Pseudo-Random Number Generator (PRNG)",
                "type": "CWE"
              }
            ]
          }
        ],
        "metrics": [
          {
