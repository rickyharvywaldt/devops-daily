        ],
        "references": [
          {
            "name": "https://github.com/cloudreve/cloudreve/security/advisories/GHSA-f8xp-wvcx-p6f4",
            "tags": [
              "x_refsource_CONFIRM"
            ],
            "url": "https://github.com/cloudreve/cloudreve/security/advisories/GHSA-f8xp-wvcx-p6f4"
