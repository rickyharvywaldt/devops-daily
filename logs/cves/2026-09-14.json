        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2511563"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in peft. The LoRA-GA and CorDA initialization modules within Hugging Face peft improperly call `torch.load()` without the `weights_only=True` parameter. This oversight allows for full pickle deserialization when loading a malicious cache or covariance file. A remote attacker could exploit this by tricking a user into loading a specially crafted file, leading to arbitrary code execution on the affected system.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "peft: peft: Arbitrary Code Execution via Unsafe Deserialization in LoRA-GA and CorDA Modules",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "Red Hat ships Hugging Face peft (versions up to 0.19.1, all within the vulnerable range) across multiple AI/ML product images: OpenShift AI (RHOAI), the AI Inference Server (vLLM ROCm), RHEL AI, and Lightspeed Stack. The LoRA-GA and CorDA initialization modules call torch.load() on config-specified cache/covariance files without weights_only=True, enabling full pickle deserialization and arbitrary code execution if a malicious cache file is loaded. Resolution is delegated to each image's maintainers to update the pinned peft dependency; trackers have been filed against all affected streams.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
