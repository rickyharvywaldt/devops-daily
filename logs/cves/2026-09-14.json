              "Red Hat OpenShift AI 2.25:registry.redhat.io/rhoai/odh-built-in-detector-rhel9@sha256:098f5e28dfc097b69748be2d9fdd392a4bf03b8c43ce2c049bbb60c87f66ab68_s390x",
