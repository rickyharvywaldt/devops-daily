        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2453930"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in Open Neural Network Exchange (ONNX). An attacker could exploit a vulnerability in how ONNX processes model metadata, specifically within the ExternalDataInfo class. By crafting a malicious ONNX model, an attacker could overwrite internal object properties, leading to a denial of service, which makes the system unavailable. This vulnerability could also result in limited information disclosure or data alteration.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "ONNX: ONNX: Denial of Service and potential information disclosure via malicious model metadata",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "A flaw in the ONNX ExternalDataInfo class allows an attacker to craft a malicious model that can overwrite internal object properties, leading to a denial of service or potential information disclosure. This vulnerability affects Red Hat OpenShift AI and Fedora when processing untrusted ONNX models.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
