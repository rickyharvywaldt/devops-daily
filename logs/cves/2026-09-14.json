        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2498188"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in `guardrails-detectors`, a component of Red Hat OpenShift AI. This vulnerability, known as Regular Expression Denial of Service (ReDoS), allows a remote attacker to provide specially crafted regular expressions to the public detection API. This can cause catastrophic backtracking, leading to a worker process consuming 100% CPU indefinitely and resulting in a denial of service for the entire guardrails-mediated LLM pipeline.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "guardrails-detectors: guardrails-detectors: Unauthenticated Regular-Expression Denial of Service (ReDoS) via detector_params.regex",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "This Moderate impact vulnerability in `guardrails-detectors` within Red Hat OpenShift AI allows an unauthenticated attacker on an adjacent network to trigger a Regular Expression Denial of Service (ReDoS). By sending a crafted regular expression to the public detection API, an attacker can consume worker processes indefinitely, leading to a denial of service for the guardrails-mediated LLM pipeline or a bypass of guardrail protections. Exploitation requires network adjacency, as end-users do not directly interact with the vulnerable API.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
