              "AppStream-9.2.0.Z.MAIN.EUS:go-toolset-0:1.19.13-1.el9_2.ppc64le",
              "AppStream-9.2.0.Z.MAIN.EUS:go-toolset-0:1.19.13-1.el9_2.s390x",
