      {
        "cve": "CVE-2022-42889",
        "cwe": {
          "id": "CWE-94",
          "name": "Improper Control of Generation of Code ('Code Injection')"
        },
        "discovery_date": "2022-10-15T00:00:00+00:00",
        "flags": [
          {
            "label": "vulnerable_code_not_present",
            "product_ids": [
              "8Base-OCP-Tools-4.14:jenkins-0:2.426.3.1706516352-3.el8.noarch",
