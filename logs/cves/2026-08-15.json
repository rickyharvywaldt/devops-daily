        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in Go's net/mail standard library package. The ParseAddressList function incorrectly handles comments (text within parentheses) within display names. Since this is a misalignment with conforming address parsers, it can result in different trust decisions made by programs using different parsers.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "golang: net/mail: comments in display names are incorrectly handled",
            "title": "Vulnerability summary"
          },
          {
