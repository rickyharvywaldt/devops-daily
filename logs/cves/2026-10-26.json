        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in golang.org/x/text. An attacker can cause a Denial of Service (DoS) by submitting specially crafted input to an application utilizing the Nickname profile. When transforming this input into an undersized destination buffer, an out-of-bounds slice indexing error occurs, causing the application to panic and crash.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "golang.org/x/text: golang.org/x/text: Denial of Service via out-of-bounds slice error in Nickname profile",
            "title": "Vulnerability summary"
          },
