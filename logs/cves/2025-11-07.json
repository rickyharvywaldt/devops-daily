        "cve": "CVE-2025-9162",
        "cwe": {
          "id": "CWE-526",
          "name": "Cleartext Storage of Sensitive Information in an Environment Variable"
        },
        "discovery_date": "2025-08-19T13:07:08.679000+00:00",
        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2389396"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in org.keycloak/keycloak-model-storage-service. The KeycloakRealmImport custom resource substitutes placeholders within imported realm documents, potentially referencing environment variables. This substitution process\nallows for injection attacks when crafted realm documents are processed. An attacker can leverage this to inject malicious content during the realm import procedure. This can lead to unintended consequences within the Keycloak environment.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "org.keycloak/keycloak-model-storage-service: Variable injection into environment variables",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
