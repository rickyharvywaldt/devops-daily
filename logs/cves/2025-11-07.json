        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in the Grafana package. When data-source query caching is enabled, Grafana caches all headers, including `grafana_session.` As a result, any user that queries a data source where the caching is enabled can acquire another user’s session.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "grafana: Use of Cache Containing Sensitive Information",
            "title": "Vulnerability summary"
          },
          {
