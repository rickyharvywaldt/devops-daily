    "vulnerabilities": [
      {
        "cve": "CVE-2020-23922",
        "cwe": {
          "id": "CWE-125",
          "name": "Out-of-bounds Read"
        },
        "discovery_date": "2020-08-02T00:00:00+00:00",
        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "1953004"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in giflib. A missing check in function DumpScreen2RGB in gif2rgb.c leads to an out-of-bounds read, allowing an attacker to crash the gif2rgb tool. The issue is not in the giflib library, but in the gif2rgb utility program.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "giflib: out-of-bounds read in DumpScreen2RGB() in gif2rgb.c in gif2rgb tool",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "This Moderate impact flaw affects the `gif2rgb` utility, not the `giflib` library. A missing bounds check in 'DumpScreen2RGB()' can lead to an out-of-bounds read when processing a crafted GIF file, causing the tool to crash. Exploitation requires local access and user interaction.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
        "product_status": {
