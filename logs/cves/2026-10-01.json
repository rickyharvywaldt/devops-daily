        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in OpenSSL. A remote attacker can cause a Denial of Service (DoS) by sending specially crafted network packets to a QUIC protocol endpoint. Because the QUIC stack retains memory in packet buffers until the receiving application reads the stream data, an attacker can manipulate data transfers to keep these buffers allocated indefinitely. This behavior leads to excessive memory consumption and can exhaust available system resources.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "openssl: openssl: Denial of Service via excessive QUIC packet buffer retention",
            "title": "Vulnerability summary"
