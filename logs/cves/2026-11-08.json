        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2542700"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in brace-expansion. A remote attacker can cause a Denial of Service (DoS) by supplying untrusted input containing deeply nested brace patterns. Due to uncontrolled recursion during pattern processing, expanding these nested structures exhausts the call stack and causes the application to crash.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "brace-expansion: brace-expansion: Denial of Service via uncontrolled recursion in nested brace patterns",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "This vulnerability is rated as Important because remote unauthenticated attackers can supply crafted nested expressions to trigger native stack exhaustion and crash server-side processes, resulting in a denial of service without compromising system confidentiality or integrity. In Red Hat environments, the affected library is distributed across containerized web consoles, developer tools, and Node.js runtime environments. Exploitation is constrained to deployments where applications process untrusted, user-defined pattern inputs directly through expansion functions without input depth validation.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
