        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2561461"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in the klauspost compress library. A remote attacker can exploit this vulnerability by submitting a specially crafted Zstandard (zstd) compressed stream to an application using the library, resulting in a Denial of Service (DoS). Due to an integer handling error in the decompression logic, the decoder retains stale internal state and performs an out-of-bounds read, triggering an unhandled panic that crashes the application.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "github.com/klauspost/compress/zstd: klauspost/compress: Denial of Service via crafted zstd compressed input",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "A flaw was found in the klauspost compress library's Zstandard (zstd) decompression implementation. An integer handling flaw in the FSE normalized count parsing logic allows a remote attacker to supply a specially crafted two-block compressed stream. When processed by vulnerable decode routines, the parser retains stale decode-table state and executes an out-of-bounds read, triggering an unhandled runtime panic. Applications decompressing untrusted inputs will terminate abruptly, causing a denial of service, while container boundaries and non-root execution isolate the impact from the underlying host.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
