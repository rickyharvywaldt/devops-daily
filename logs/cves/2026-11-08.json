        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2526955"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in gRPC-Go. This vulnerability allows an unauthenticated remote attacker to exhaust process memory by sending millions of fragmented HTTP/2 DATA frames. Each fragmented frame is stored as a separate message, consuming disproportionate heap memory. This can lead to a runtime panic or out-of-memory termination, resulting in a Denial of Service (DoS).",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "google.golang.org/grpc: gRPC-Go: Denial of Service via HTTP/2 DATA Frame Fragmentation",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "Red Hat has evaluated this vulnerability as having an Important severity because an unauthenticated remote attacker can exhaust memory and crash affected applications without exceeding connection flow-control windows. Within Red Hat OpenShift and containerized platforms, gRPC-Go is embedded in various internal control plane agents, monitoring exporters, and management components. Although services handling untrusted remote gRPC traffic remain susceptible to denial of service, exposure in standard cluster deployments is constrained because these interfaces typically operate across isolated internal networks or behind mutual TLS boundaries.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
