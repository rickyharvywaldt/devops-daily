      "cna": {
        "title": "Allocation of Resources Without Limits or Throttling in GitLab",
        "descriptions": [
          {
            "lang": "en",
            "value": "GitLab has remediated an issue in GitLab CE/EE affecting all versions from 11.0 before 18.3.5, 18.4 before 18.4.3, and 18.5 before 18.5.1 that could have allowed an unauthenticated attacker to cause a denial of service condition by sending GraphQL requests with crafted JSON payloads."
          }
        ],
        "affected": [
          {
            "vendor": "GitLab",
            "product": "GitLab",
