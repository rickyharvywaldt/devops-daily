      "cna": {
        "title": "Libcap: libcap: privilege escalation via toctou race condition in cap_set_file()",
        "metrics": [
          {
            "other": {
              "content": {
                "value": "Important",
                "namespace": "https://access.redhat.com/security/updates/classification/"
              },
              "type": "Red Hat severity rating"
