          "dateUpdated": "2026-09-04T19:59:28.308Z"
        },
        "descriptions": [
          {
            "lang": "en",
            "value": "No authentication exists in the MQTT service of Trueview 6.0.23.4. The MQTT broker accepts client connections on TCP port 1883 without requiring authentication, allowing a remote attacker with network access to establish an MQTT session and perform unauthorized publish or subscribe operations."
          }
        ],
