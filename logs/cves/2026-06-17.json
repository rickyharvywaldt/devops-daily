        "flags": [
          {
            "label": "vulnerable_code_not_present",
            "product_ids": [
              "Red Hat OpenStack Platform 17.1:registry.redhat.io/rhosp-rhel9/osp-director-downloader@sha256:dfdc74ce40312f0452b1c88bad6af9501791478ca7e993dc9be08bf80c9df7b6_amd64",
