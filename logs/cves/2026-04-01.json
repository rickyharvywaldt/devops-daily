              "Red Hat Advanced Cluster Management for Kubernetes 2.14:registry.redhat.io/rhacm2/volsync-operator-bundle@sha256:dd464544e3bd41b77c7042360df3a34b1c31bbdb8c5f8bc6053d7b870184f0b0_amd64"
