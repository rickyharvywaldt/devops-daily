          "name": "Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution')"
        },
        "discovery_date": "2026-01-21T20:01:28.774829+00:00",
        "flags": [
          {
            "label": "vulnerable_code_not_present",
            "product_ids": [
