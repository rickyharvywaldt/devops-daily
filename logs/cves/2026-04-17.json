            "product": "MasterStudy LMS WordPress Plugin – for Online Courses and Education",
            "versions": [
              {
                "version": "0",
                "status": "affected",
                "lessThanOrEqual": "3.7.25",
                "versionType": "semver"
              }
            ],
            "defaultStatus": "unaffected"
