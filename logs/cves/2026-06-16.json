        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in Pillow, a Python imaging library. This vulnerability allows a remote attacker to trigger a denial of service (DoS) by providing a specially crafted FITS image file. The library's failure to limit the amount of GZIP-compressed data during decoding can lead to unbounded memory consumption, causing the system to crash or experience severe performance issues.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "Pillow: Pillow: Denial of Service via decompression bomb in FITS image processing",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
