        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in Red Hat Quay's container image upload process. An authenticated user with push access to any repository on the registry can interfere with image uploads in progress by other users, including those in repositories they do not have access to. This could allow the attacker to read, modify, or cancel another user's in-progress image upload.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "mirror-registry: quay: insecure direct object reference in BlobUpload",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "Exploitation requires valid login credentials to the Quay registry. Unauthenticated users cannot exploit this flaw.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
