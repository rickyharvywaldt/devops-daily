        "title": "FreeRDP 3.0.0 before 3.32.0 Infinite Loop DoS via Gateway Content-Type",
        "descriptions": [
          {
            "lang": "en",
            "value": "FreeRDP from 3.0.0 before 3.32.0 contains an infinite loop vulnerability in http_response_recv() that allows malicious gateways to exhaust client CPU via crafted Content-Type headers. Attackers controlling a gateway can return a nonzero Content-Length with a semicolon-containing unrecognized Content-Type, pinning a client thread at full CPU indefinitely."
          }
        ],
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "description": "Loop with Unreachable Exit Condition ('Infinite Loop')",
                "cweId": "CWE-835",
                "type": "CWE"
              }
            ]
          }
        ],
        "affected": [
