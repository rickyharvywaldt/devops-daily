      "cveId": "CVE-2026-70375",
      "assignerOrgId": "309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c",
      "state": "PUBLISHED",
      "assignerShortName": "TuranSec",
      "dateReserved": "2026-08-04T07:13:07.993Z",
