        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in Skia, a 2D graphics library used in Google Chrome. This vulnerability, stemming from an uninitialized resource, allows a remote attacker to obtain sensitive cross-origin data. By crafting a malicious HTML page, an attacker can trick a user into visiting it, leading to the unauthorized disclosure of information from other web origins.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "chromium-browser: skia: Google Chrome: Cross-origin data disclosure due to uninitialized resource in Skia",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
