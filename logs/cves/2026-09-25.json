        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in Skia, a 2D graphics library used in chromium-browser. This improper state validation vulnerability allows a remote attacker, who has already compromised the renderer process, to read memory outside of the security sandbox. This can be achieved by enticing a user to open a specially crafted HTML page, leading to information disclosure.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "chromium-browser: skia: Skia in chromium-browser: Information disclosure via improper state validation",
            "title": "Vulnerability summary"
          },
