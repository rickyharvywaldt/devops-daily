        "title": "Botslab G980H Dashcams Missing Authentication for Critical Function",
        "datePublic": "2026-09-24T14:31:00.000Z",
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "cweId": "CWE-306",
                "description": "CWE-306 Missing authentication for critical function",
