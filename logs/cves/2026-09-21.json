  {
    "document": {
      "aggregate_severity": {
        "namespace": "https://access.redhat.com/security/updates/classification/",
        "text": "Important"
      },
      "category": "csaf_security_advisory",
      "csaf_version": "2.0",
      "distribution": {
        "text": "Copyright © Red Hat, Inc. All rights reserved.",
        "tlp": {
          "label": "WHITE",
          "url": "https://www.first.org/tlp/"
