                "versionType": "semver"
              },
              {
                "version": "1.26.0-0",
                "lessThan": "1.26.2",
                "status": "affected",
                "versionType": "semver"
              }
            ],
            "programRoutines": [
              {
                "name": "context.String"
              },
              {
                "name": "context.mangle"
              },
              {
                "name": "escaper.escapeBranch"
              },
              {
                "name": "Error.Error"
              },
              {
                "name": "HTMLEscaper"
