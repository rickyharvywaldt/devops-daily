    "cveMetadata": {
      "cveId": "CVE-2026-99284",
      "assignerOrgId": "416baaa9-dc9f-4396-8d5f-8c081fb06d67",
      "state": "PUBLISHED",
      "assignerShortName": "Linux",
      "dateReserved": "2026-09-25T10:25:14.405Z",
      "datePublished": "2026-11-07T20:40:33.661Z",
