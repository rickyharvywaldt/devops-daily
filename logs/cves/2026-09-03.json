    "cveMetadata": {
      "cveId": "CVE-2026-64446",
      "assignerOrgId": "416baaa9-dc9f-4396-8d5f-8c081fb06d67",
      "state": "PUBLISHED",
      "assignerShortName": "Linux",
      "dateReserved": "2026-07-19T15:36:31.788Z",
      "datePublished": "2026-07-25T08:51:17.402Z",
