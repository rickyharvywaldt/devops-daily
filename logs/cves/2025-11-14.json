        "notes": [
          {
            "category": "description",
            "text": "A flaw exists in the collection remote for pulp_ansible, where tokens are stored in plaintext instead of using pulp's encrypted field. This flaw allows an attacker with sufficient privileges to read the stored tokens, resulting in the loss of confidentiality.",
            "title": "Vulnerability description"
          },
