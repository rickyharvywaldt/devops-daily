        "title": "WP eCommerce <= 3.15.1 - Coupon Deletion via CSRF",
        "problemTypes": [
          {
            "descriptions": [
              {
                "description": "CWE-352 Cross-Site Request Forgery (CSRF)",
                "lang": "en",
                "type": "CWE"
              }
            ]
          }
        ],
        "affected": [
          {
            "vendor": "Unknown",
            "product": "WP eCommerce",
            "versions": [
              {
                "status": "affected",
                "versionType": "semver",
                "version": "0",
                "lessThanOrEqual": "3.15.1"
              }
            ],
            "defaultStatus": "affected"
          }
        ],
        "descriptions": [
          {
            "lang": "en",
            "value": "The WP eCommerce WordPress plugin through 3.15.1 does not have CSRF check in place when deleting coupons, which could allow attackers to make a logged in admin remove them via a CSRF attack"
          }
        ],
        "references": [
          {
