        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in the Linux kernel's handling of TCP sockets. An unprivileged application can exploit this vulnerability by attaching a Berkeley Packet Filter (BPF) using the SO_ATTACH_FILTER option. This allows the application to conduct a side-channel attack, leading to the leakage of sensitive TCP sequence and acknowledgment numbers. This information disclosure could potentially be used to aid further attacks.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "kernel: tcp: restrict SO_ATTACH_FILTER to priv users",
            "title": "Vulnerability summary"
