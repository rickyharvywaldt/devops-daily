        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in the Linux kernel's network handshake component. When a network namespace exits, pending handshake requests may not be properly released due to incorrect list handling. This can lead to resource leaks and a list-corruption race, potentially resulting in memory corruption. An attacker could exploit this to cause system instability or a denial of service.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "kernel: net/handshake: Drain pending requests at net namespace exit",
            "title": "Vulnerability summary"
          },
