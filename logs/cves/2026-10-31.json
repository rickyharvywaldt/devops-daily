      },
      {
        "cve": "CVE-2026-72083",
        "cwe": {
          "id": "CWE-825",
          "name": "Expired Pointer Dereference"
        },
        "discovery_date": "2026-08-15T00:00:00+00:00",
        "ids": [
          {
            "system_name": "Red Hat Bugzilla ID",
            "text": "2516579"
          }
        ],
        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in the Linux kernel's iSCSI target core. This use-after-free vulnerability occurs in the `core_scsi3_emulate_pro_register_and_move()` function. When processing iSCSI TransportIDs, a memory buffer is prematurely unmapped while still being referenced, particularly when the parameter list spans multiple pages. An attacker could potentially exploit this to cause a system crash, leading to a denial of service.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "kernel: scsi: target: core: Fix iSCSI ISID use-after-free in REGISTER AND MOVE",
            "title": "Vulnerability summary"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
