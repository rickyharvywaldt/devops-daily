            }
          }
        ],
        "solutions": [
          {
            "lang": "en",
            "value": "Update to Iperius Backup 8.8.9. According to the manufacturer, this version includes restrictive permissions by default that prevent the vulnerability. When the service is installed, it applies these permissions to the configuration folders and prevents non-administrator users from creating, modifying or running backup jobs.",
            "supportingMedia": [
              {
