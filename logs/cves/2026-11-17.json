        "title": "Privilege escalation in Enter’s Iperius Backup",
        "datePublic": "2026-11-11T09:35:00.000Z",
        "problemTypes": [
          {
            "descriptions": [
              {
                "lang": "en",
                "cweId": "CWE-250",
                "description": "CWE-250 Execution with unnecessary privileges",
                "type": "CWE"
              }
            ]
          }
        ],
        "affected": [
          {
            "vendor": "Enter",
            "product": "Iperius Backup",
            "versions": [
              {
                "status": "affected",
                "version": "8.8.3 for Windows"
              }
            ],
            "defaultStatus": "unaffected"
          }
        ],
        "cpeApplicability": [
          {
            "operator": "OR",
            "nodes": [
              {
                "operator": "OR",
                "negate": false,
                "cpeMatch": [
                  {
                    "vulnerable": true,
                    "criteria": "cpe:2.3:a:enter:iperius_backup:8.8.3_for_windows:*:*:*:*:*:*:*"
                  }
                ]
              }
            ]
          }
        ],
        "descriptions": [
          {
            "lang": "en",
            "value": "Local privilege escalation vulnerability in Iperius Backup 8.8.3, due to insufficient separation between the graphical user interface running with elevated privileges and local users with low privileges. When the backup service is configured to run persistently with Administrator privileges, a local attacker with low privileges can use the native Windows dialogues exposed by the application to run programmes that inherit its elevated context. This allows commands to be executed with SYSTEM or Administrator privileges, depending on the application’s context, and compromises the affected Windows system.",
            "supportingMedia": [
              {
                "type": "text/html",
                "base64": false,
                "value": "Local privilege escalation vulnerability in Iperius Backup 8.8.3, due to insufficient separation between the graphical user interface running with elevated privileges and local users with low privileges. When the backup service is configured to run persistently with Administrator privileges, a local attacker with low privileges can use the native Windows dialogues exposed by the application to run programmes that inherit its elevated context. This allows commands to be executed with SYSTEM or Administrator privileges, depending on the application’s context, and compromises the affected Windows system."
              }
            ]
          }
        ],
        "references": [
          {
            "url": "https://www.incibe.es/en/incibe-cert/notices/aviso/privilege-escalation-enters-iperius-backup"
          }
        ],
