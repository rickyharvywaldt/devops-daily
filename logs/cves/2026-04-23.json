    "containers": {
      "cna": {
        "title": "Claude Code: Sandbox Escape via Symlink Following Allows Arbitrary File Write Outside Workspace",
        "problemTypes": [
          {
            "descriptions": [
              {
                "cweId": "CWE-22",
                "lang": "en",
                "description": "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')",
