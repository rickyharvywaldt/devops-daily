        "title": "WP reCaptcha by WebDesignBy < 2.0 – Admin+ Stored XSS",
        "problemTypes": [
          {
            "descriptions": [
              {
                "description": "CWE-79 Cross-Site Scripting (XSS)",
                "lang": "en",
                "type": "CWE"
