              "Red Hat OpenShift AI 3.4:registry.redhat.io/rhoai/odh-ai-gateway-payload-processing-rhel9@sha256:145511ba70395e89ad2b6861210d079d54a11159c53df100bcf17c60ccb0477b_amd64",
              "Red Hat OpenShift AI 3.4:registry.redhat.io/rhoai/odh-ai-gateway-payload-processing-rhel9@sha256:1b151f2faf541c3e1923d511c49486611f24c8a974dc9ba071c5fb06f2753dd5_ppc64le",
