        "cve": "CVE-2026-25679",
        "cwe": {
          "id": "CWE-1286",
          "name": "Improper Validation of Syntactic Correctness of Input"
        },
        "discovery_date": "2026-03-06T22:02:11.567841+00:00",
        "ids": [
