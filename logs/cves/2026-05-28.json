        "notes": [
          {
            "category": "description",
            "text": "A flaw was found in the Golang package cmd/go. This issue permits the fallback to insecure \"git://\" if trying to fetch a .git module that has no \"https://\" or \"git+ssh://\" available.",
            "title": "Vulnerability description"
          },
          {
            "category": "summary",
            "text": "golang: cmd/go: Protocol Fallback when fetching modules",
            "title": "Vulnerability summary"
          },
          {
            "category": "other",
            "text": "Red Hat rates this issue as Moderate, as the default configuration avoids this behavior, mitigating the vulnerability.",
            "title": "Statement"
          },
          {
            "category": "general",
            "text": "The CVSS score(s) listed for this vulnerability do not reflect the associated product's status, and are included for informational purposes to better understand the severity of this vulnerability.",
            "title": "CVSS score applicability"
          }
        ],
